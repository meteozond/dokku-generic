#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/common-functions"
source "$PLUGIN_BASE_PATH/functions"

case "$1" in
  generic:help | generic)
    source "$PLUGIN_BASE_PATH/help-functions"
    cat <<EOF
Usage: dokku generic[:COMMAND] ...

Commands:
$(cmd_create_help | head -3)
$(cmd_destroy_help | head -3)
$(cmd_list_help | head -3)
$(cmd_exists_help | head -3)
$(cmd_info_help | head -3)
$(cmd_config_help | head -3)
$(cmd_set_help | head -3)
$(cmd_unset_help | head -3)
$(cmd_upgrade_help | head -3)
$(cmd_start_help | head -3)
$(cmd_stop_help | head -3)
$(cmd_restart_help | head -3)
$(cmd_pause_help | head -3)
$(cmd_enter_help | head -3)
$(cmd_exec_help | head -3)
$(cmd_logs_help | head -3)
$(cmd_link_help | head -3)

For full help on a command: dokku generic:<command> --help (TBD in Plan 8)
EOF
    ;;
  generic:create | generic:destroy | generic:exists | generic:list | generic:info | generic:config | generic:set | generic:unset | generic:upgrade | generic:start | generic:stop | generic:restart | generic:pause | generic:enter | generic:exec | generic:logs | generic:link)
    SUBCOMMAND="${1#generic:}"
    if [[ -x "$PLUGIN_BASE_PATH/subcommands/$SUBCOMMAND" ]]; then
      "$PLUGIN_BASE_PATH/subcommands/$SUBCOMMAND" "$@"
    else
      echo " !  Subcommand $SUBCOMMAND not implemented yet" >&2
      exit 1
    fi
    ;;
  *)
    # Pass through unhandled to allow other plugins
    # shellcheck disable=SC2317  # exit 0 is the fallback when not sourced
    return 0 2>/dev/null || exit 0
    ;;
esac
