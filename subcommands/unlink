#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")" && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/common-functions"
source "$PLUGIN_BASE_PATH/functions"

shift
SERVICE="${1:-}"
APP="${2:-}"

[[ -z "$SERVICE" ]] && dokku_log_fail "Please specify a valid service name"
[[ -z "$APP" ]] && dokku_log_fail "Please specify a valid app name"
verify_service_name "$SERVICE" || dokku_log_fail "Invalid service name"
service_exists "$SERVICE" || dokku_log_fail "Service $SERVICE does not exist"
acquire_service_lock "$SERVICE"

ROOT="$(service_root "$SERVICE")"
NETWORK="$(service_network_name "$SERVICE")"
LINKS_FILE="$ROOT/LINKS"

if ! grep -qxF "$APP" "$LINKS_FILE" 2>/dev/null; then
  dokku_log_fail "Service $SERVICE is not linked to $APP"
fi

# Remove --network option from docker-options
dokku docker-options:remove "$APP" build,deploy,run "--network=$NETWORK" 2>/dev/null || true

# Determine which config keys to unset.
declare -a TO_UNSET=()
ALIAS_FILE="$ROOT/APPS/$APP"
if [[ -f "$ALIAS_FILE" ]]; then
  # New-style: alias is recorded — unset exactly PREFIX_HOST/PORT/URL + LINK_ENV keys.
  ALIAS=$(<"$ALIAS_FILE")
  for suffix in HOST PORT URL; do
    TO_UNSET+=("${ALIAS}_${suffix}")
  done
else
  # Legacy fallback: find keys whose value references the service DNS name.
  DNS="$(service_container_name "$SERVICE")"
  while IFS='=' read -r key val; do
    [[ -z "$key" ]] && continue
    strip_envfile_quotes key val
    if [[ "$val" == *"$DNS"* ]]; then
      TO_UNSET+=("$key")
    fi
  done < <(dokku config:export --format=envfile "$APP" 2>/dev/null || true)
fi

# LINK_ENV keys (may not reference DNS but were set by link).
if [[ -f "$ROOT/LINK_ENV" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    key="${line%%=*}"
    found=0
    for k in "${TO_UNSET[@]}"; do
      [[ "$k" == "$key" ]] && {
        found=1
        break
      }
    done
    [[ $found -eq 0 ]] && TO_UNSET+=("$key")
  done <"$ROOT/LINK_ENV"
fi

if [[ ${#TO_UNSET[@]} -gt 0 ]]; then
  dokku config:unset "$APP" "${TO_UNSET[@]}" >/dev/null 2>&1 || true
fi

atomic_remove_line "$LINKS_FILE" fixed "$APP"
rm -f "$ALIAS_FILE"

dokku_log_info2 "$PLUGIN_SERVICE service $SERVICE unlinked from $APP"
