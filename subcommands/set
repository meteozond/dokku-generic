#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")" && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/common-functions"
source "$PLUGIN_BASE_PATH/functions"

shift
SERVICE=""
declare -a TO_SET_ENV=() TO_SET_LINK_ENV=() TO_ADD_MOUNT=() TO_ADD_DOCKER_ARG=()
NEW_IMAGE="" NEW_PORT="" NEW_SCHEME="" NEW_CMD="" NEW_ENTRYPOINT=""
NO_RESTART=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image)
      NEW_IMAGE="$2"
      shift 2
      ;;
    --image=*)
      NEW_IMAGE="${1#--image=}"
      shift
      ;;
    --port)
      NEW_PORT="$2"
      shift 2
      ;;
    --port=*)
      NEW_PORT="${1#--port=}"
      shift
      ;;
    --scheme)
      NEW_SCHEME="$2"
      shift 2
      ;;
    --scheme=*)
      NEW_SCHEME="${1#--scheme=}"
      shift
      ;;
    --env)
      TO_SET_ENV+=("$2")
      shift 2
      ;;
    --env=*)
      TO_SET_ENV+=("${1#--env=}")
      shift
      ;;
    --link-env)
      TO_SET_LINK_ENV+=("$2")
      shift 2
      ;;
    --link-env=*)
      TO_SET_LINK_ENV+=("${1#--link-env=}")
      shift
      ;;
    --mount)
      TO_ADD_MOUNT+=("$2")
      shift 2
      ;;
    --mount=*)
      TO_ADD_MOUNT+=("${1#--mount=}")
      shift
      ;;
    --cmd)
      NEW_CMD="$2"
      shift 2
      ;;
    --cmd=*)
      NEW_CMD="${1#--cmd=}"
      shift
      ;;
    --entrypoint)
      NEW_ENTRYPOINT="$2"
      shift 2
      ;;
    --entrypoint=*)
      NEW_ENTRYPOINT="${1#--entrypoint=}"
      shift
      ;;
    --docker-arg)
      TO_ADD_DOCKER_ARG+=("$2")
      shift 2
      ;;
    --docker-arg=*)
      TO_ADD_DOCKER_ARG+=("${1#--docker-arg=}")
      shift
      ;;
    --no-restart)
      NO_RESTART=1
      shift
      ;;
    -*) dokku_log_fail "Unknown flag: $1" ;;
    *)
      [[ -n "$SERVICE" ]] && dokku_log_fail "Unexpected: $1"
      SERVICE="$1"
      shift
      ;;
  esac
done

[[ -z "$SERVICE" ]] && dokku_log_fail "Please specify a valid name for the service"
verify_service_name "$SERVICE" || dokku_log_fail "Invalid service name: $SERVICE"
service_exists "$SERVICE" || dokku_log_fail "Service $SERVICE does not exist"
acquire_service_lock "$SERVICE"

ROOT="$(service_root "$SERVICE")"

declare -a CHANGED=()

# Writes a scalar file only when the content differs.
# $1 file name, $2 new value, $3 printf format (CMD and ENTRYPOINT have no newline).
set_scalar() {
  local name="$1" value="$2" fmt="$3" current=""
  [[ -f "$ROOT/$name" ]] && current="$(<"$ROOT/$name")"
  [[ "$current" == "$value" ]] && return 0
  # shellcheck disable=SC2059
  printf "$fmt" "$value" >"$ROOT/$name"
  CHANGED+=("$name")
}

# Appends a line to a list file unless it is already there.
append_unique() {
  local name="$1" line="$2"
  if [[ -f "$ROOT/$name" ]] && grep -qxF -- "$line" "$ROOT/$name"; then
    return 0
  fi
  printf '%s\n' "$line" >>"$ROOT/$name"
  CHANGED+=("$name")
}

# Sets KEY=VALUE in an env file unless the same line is already there.
set_env_unique() {
  local name="$1" key="$2" val="$3"
  if [[ -f "$ROOT/$name" ]] && grep -qxF -- "${key}=$(env_escape "$val")" "$ROOT/$name"; then
    return 0
  fi
  env_set "$ROOT/$name" "$key" "$val"
  CHANGED+=("$name")
}

# Apply scalar fields
[[ -n "$NEW_IMAGE" ]] && set_scalar IMAGE "$NEW_IMAGE" '%s\n'
[[ -n "$NEW_PORT" ]] && set_scalar PORT "$NEW_PORT" '%s\n'
[[ -n "$NEW_SCHEME" ]] && set_scalar SCHEME "$NEW_SCHEME" '%s\n'
[[ -n "$NEW_CMD" ]] && set_scalar CMD "$NEW_CMD" '%s'
[[ -n "$NEW_ENTRYPOINT" ]] && set_scalar ENTRYPOINT "$NEW_ENTRYPOINT" '%s'

# Apply env / link-env
for pair in "${TO_SET_ENV[@]}"; do
  [[ "$pair" != *=* ]] && dokku_log_fail "Invalid --env: $pair"
  key="${pair%%=*}"
  val="${pair#*=}"
  [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || dokku_log_fail "Invalid --env key: $key"
  set_env_unique ENV "$key" "$val"
done
for pair in "${TO_SET_LINK_ENV[@]}"; do
  [[ "$pair" != *=* ]] && dokku_log_fail "Invalid --link-env: $pair"
  key="${pair%%=*}"
  val="${pair#*=}"
  [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || dokku_log_fail "Invalid --link-env key: $key"
  set_env_unique LINK_ENV "$key" "$val"
done

# Append mounts and docker args (skip duplicates already present)
for spec in "${TO_ADD_MOUNT[@]}"; do
  parse_mount_spec "$spec" >/dev/null || dokku_log_fail "Invalid --mount: $spec"
  append_unique MOUNTS "$spec"
done
for da in "${TO_ADD_DOCKER_ARG[@]}"; do
  append_unique DOCKER_ARGS "$da"
done

if [[ ${#CHANGED[@]} -eq 0 ]]; then
  dokku_log_info1 "No changes for $SERVICE"
  exit 0
fi

dokku_log_info1 "Changed for $SERVICE: ${CHANGED[*]}"
dokku_log_info1 "Updated $SERVICE state"

# Restart if running (unless --no-restart was passed)
if [[ $NO_RESTART -eq 1 ]]; then
  dokku_log_info1 "Skipping restart (--no-restart)"
elif service_is_running "$SERVICE"; then
  dokku_log_info1 "Restarting service to apply changes"
  service_restart_internal "$SERVICE"
fi
