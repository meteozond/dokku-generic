#!/usr/bin/env bash
# functions: plugin-specific helpers.

# Global arrays populated by build_run_args / build_cmd_args.
# Pre-declared at source time so callers on bash 3 can still expand them.
_DOCKER_RUN_ARGS=()
_DOCKER_CMD_ARGS=()

# Populates global array _DOCKER_RUN_ARGS with docker run options (env/mount/entrypoint/docker-args).
# Caller expands as "${_DOCKER_RUN_ARGS[@]}" — preserves whitespace in values.
build_run_args() {
  local service="$1"
  local root
  root="$(service_root "$service")"

  _DOCKER_RUN_ARGS=()

  # ENV → -e flags
  if [[ -f "$root/ENV" ]]; then
    local line key val
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      key="${line%%=*}"
      val="${line#*=}"
      _DOCKER_RUN_ARGS+=(-e "$key=$(env_unescape "$val")")
    done < "$root/ENV"
  fi

  # MOUNTS → -v flags
  if [[ -f "$root/MOUNTS" ]]; then
    local line type src tgt mode parsed
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      parsed=$(parse_mount_spec "$line") || continue
      IFS='|' read -r type src tgt mode <<< "$parsed"
      if [[ "$type" == "named" && -z "$src" ]]; then
        src="$(mount_volume_name "$service" "$tgt")"
      fi
      _DOCKER_RUN_ARGS+=(-v "${src}:${tgt}:${mode}")
    done < "$root/MOUNTS"
  fi

  # ENTRYPOINT
  if [[ -s "$root/ENTRYPOINT" ]]; then
    _DOCKER_RUN_ARGS+=(--entrypoint "$(<"$root/ENTRYPOINT")")
  fi

  # DOCKER_ARGS — each line is one arg (preserves whitespace within a line)
  if [[ -f "$root/DOCKER_ARGS" ]]; then
    local arg
    while IFS= read -r arg; do
      [[ -z "$arg" ]] && continue
      _DOCKER_RUN_ARGS+=("$arg")
    done < "$root/DOCKER_ARGS"
  fi
}

# Populates global array _DOCKER_CMD_ARGS with CMD-override tokens.
# Tokenization matches /bin/sh -c semantics (split on whitespace).
build_cmd_args() {
  local service="$1"
  local root
  root="$(service_root "$service")"

  _DOCKER_CMD_ARGS=()

  if [[ -s "$root/CMD" ]]; then
    local content
    content=$(<"$root/CMD")
    # shellcheck disable=SC2206
    _DOCKER_CMD_ARGS=($content)
  fi
}

# Stops the existing container (if any), and re-runs it with current state.
service_restart_internal() {
  local service="$1"
  local container network image
  container="$(service_container_name "$service")"
  network="$(service_network_name "$service")"
  image=$(<"$(service_root "$service")/IMAGE")

  # Stop+rm existing
  if "$DOCKER_BIN" container inspect "$container" >/dev/null 2>&1; then
    "$DOCKER_BIN" container stop -t "$PLUGIN_STOP_TIMEOUT" "$container" >/dev/null 2>&1 || true
    "$DOCKER_BIN" container rm "$container" >/dev/null 2>&1 || true
  fi

  # Ensure network exists
  "$DOCKER_BIN" network inspect "$network" >/dev/null 2>&1 \
    || "$DOCKER_BIN" network create "$network" >/dev/null

  # Pull image if missing
  if ! "$DOCKER_BIN" image inspect "$image" >/dev/null 2>&1; then
    "$DOCKER_BIN" image pull "$image" >/dev/null
  fi

  # Build args and run (build_run_args populates _DOCKER_RUN_ARGS, build_cmd_args populates _DOCKER_CMD_ARGS)
  build_run_args "$service"
  build_cmd_args "$service"

  "$DOCKER_BIN" container run -d \
    --name "$container" \
    --hostname "$container" \
    --restart unless-stopped \
    --label dokku=service \
    --label "dokku.service=$PLUGIN_SERVICE" \
    --label "dokku.generic.service=$service" \
    --network "$network" \
    --network-alias "$service" \
    "${_DOCKER_RUN_ARGS[@]}" \
    "$image" \
    "${_DOCKER_CMD_ARGS[@]}" >/dev/null

  "$DOCKER_BIN" container inspect -f '{{.Id}}' "$container" > "$(service_root "$service")/ID"
}

# Returns 0 if the service container exists and is running.
service_is_running() {
  local container
  container="$(service_container_name "$1")"
  [[ "$("$DOCKER_BIN" container inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" == "true" ]]
}

# Converts a service name to an UPPER_SNAKE environment variable prefix.
# E.g. my-pg → MY_PG, my.pg → MY_PG, pg → PG.
service_alias() {
  local s="$1"
  s="${s//-/_}"
  s="${s//./_}"
  printf '%s' "$s" | tr '[:lower:]' '[:upper:]'
}

# Returns the connection URL for the service: <scheme>://<container-dns>:<port>.
# Returns empty string if PORT file is absent or empty.
service_url() {
  local service="$1"
  local root port scheme
  root="$(service_root "$service")"
  port=""
  scheme="tcp"
  [[ -f "$root/PORT" ]]   && port=$(cat "$root/PORT")
  [[ -f "$root/SCHEME" ]] && scheme=$(cat "$root/SCHEME")
  [[ -z "$port" ]] && return 0
  printf '%s://%s:%s' "$scheme" "$(service_container_name "$service")" "$port"
}

# Returns the next available alias for the app config, avoiding collisions.
# If <base_alias>_URL is unset in the app config, returns <base_alias>.
# Otherwise tries <base_alias>2, <base_alias>3, … up to 99.
service_alternative_alias() {
  local app="$1" base_alias="$2"
  local existing
  existing=$(dokku config:get "$app" "${base_alias}_URL" 2>/dev/null || true)
  if [[ -z "$existing" ]]; then
    printf '%s' "$base_alias"
    return 0
  fi
  local i=2
  while :; do
    existing=$(dokku config:get "$app" "${base_alias}${i}_URL" 2>/dev/null || true)
    if [[ -z "$existing" ]]; then
      printf '%s%d' "$base_alias" "$i"
      return 0
    fi
    ((i++))
    [[ $i -gt 99 ]] && return 1
  done
}
