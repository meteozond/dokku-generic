#!/usr/bin/env bash
# common-functions: helper functions used across subcommands.

verify_service_name() {
  local SERVICE="$1"
  if [[ -z "$SERVICE" ]]; then
    return 1
  fi
  if [[ ${#SERVICE} -gt 50 ]]; then
    return 1
  fi
  if [[ ! "$SERVICE" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]; then
    return 1
  fi
  return 0
}

env_escape() {
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//$'\n'/\\n}"
  v="${v//$'\r'/\\r}"
  printf '%s' "$v"
}

env_unescape() {
  printf '%b' "$1"
}
