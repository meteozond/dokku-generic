#!/usr/bin/env bash
# help-functions: human-readable help texts per subcommand.

cmd_create_help() {
  cat <<EOF
generic:create <service> <image[:tag]> [flags]

Create a new generic service from a Docker image.

Flags:
  --port N                Port inside container (for link/expose)
  --scheme STR            URL scheme for <PREFIX>_URL (default: tcp)
  --env KEY=VAL           Container env var (repeatable; KEY must match ^[A-Z_][A-Z0-9_]*\$)
  --link-env KEY=VAL      Extra env injected into linked apps (repeatable; same KEY regex)
  --mount SPEC            Mount: /container/path | /host:/container | name:/container[:ro|:rw]
  --expose H:C            Expose port to host immediately via ambassador (repeatable)
  --cmd "..."             CMD-override (placed after image)
  --entrypoint /bin/x     Entrypoint-override
  --docker-arg ARG        Extra arg to docker run (repeatable)
  --no-start              Create state, don't start container
EOF
}

cmd_destroy_help() {
  cat <<EOF
generic:destroy <service> [-f|--force]

Delete a service: container, network, named volumes, state.
Blocked if service has active links. Without --force prompts for service name.
EOF
}

cmd_list_help() {
  cat <<EOF
generic:list

List all generic services with image and status.
EOF
}

cmd_exists_help() {
  cat <<EOF
generic:exists <service>

Exit 0 if service exists, 1 otherwise.
EOF
}

cmd_info_help() {
  cat <<EOF
generic:info <service> [--image|--status|--port|--internal-ip|--links|--exposed-ports|--docker-args]

Show service information. Without flag prints all fields.
EOF
}

cmd_config_help() {
  cat <<EOF
generic:config <service>

Print service configuration: env vars, link-env vars, mounts, exposed ports, port, scheme.
EOF
}

cmd_set_help() {
  cat <<EOF
generic:set <service> <flags>

Update service configuration. Same flags as create (except --no-start).
Restarts container automatically if running; pass --no-restart to skip.
--mount specs are deduplicated (identical spec is not appended twice).
--env / --link-env keys must match ^[A-Z_][A-Z0-9_]*\$ (uppercase, digits, underscore).
EOF
}

cmd_unset_help() {
  cat <<EOF
generic:unset <service> --<flag> <key>

Remove specific keys from service config. Flags: --env, --link-env, --mount, --docker-arg, --expose. Restarts service if running.
EOF
}

cmd_upgrade_help() {
  cat <<EOF
generic:upgrade <service> <new-image[:tag]>

Update service to a new image. Alias for: set --image. Restarts container.
EOF
}

cmd_start_help() {
  cat <<EOF
generic:start <service>

Start a stopped service. No-op if running. Recreates from state if container missing.
EOF
}

cmd_stop_help() {
  cat <<EOF
generic:stop <service>

Stop a running service. No-op if already stopped. Container kept for fast restart.
EOF
}

cmd_restart_help() {
  cat <<EOF
generic:restart <service>

Recreate container with current state. Reads IMAGE/ENV/MOUNTS/etc fresh.
EOF
}

cmd_pause_help() {
  cat <<EOF
generic:pause <service>

Toggle pause/unpause on a running or paused container. Useful for debugging.
EOF
}

cmd_enter_help() {
  cat <<EOF
generic:enter <service>

Drop into interactive shell inside the running container. Tries bash, falls back to sh.
EOF
}

cmd_exec_help() {
  cat <<EOF
generic:exec <service> [-i] [-t] <cmd> [args...]

Run a command inside the running container. Exit code propagates.
EOF
}

cmd_logs_help() {
  cat <<EOF
generic:logs <service> [-t] [-n N] [-f]

Show container logs. Flags: -t (timestamps), -n N (last N lines), -f (follow).
EOF
}

cmd_link_help() {
  cat <<EOF
generic:link <service> <app> [--alias PREFIX]

Link service to app: adds --network to docker-options and sets <PREFIX>_HOST/PORT/URL
plus LINK_ENV vars in app config. App restarts via dokku config:set.
EOF
}

cmd_unlink_help() {
  cat <<EOF
generic:unlink <service> <app>

Disconnect service from app: removes --network from docker-options and unsets
all related config keys (those referencing the service DNS name + LINK_ENV vars).
EOF
}

cmd_linked_help() {
  cat <<EOF
generic:linked <service>

List apps linked to a service. Prints "(no apps linked)" when empty.
EOF
}

cmd_links_help() {
  cat <<EOF
generic:links <app>

List services linked to an app. Prints "(no services linked)" when empty.
EOF
}

cmd_app_links_help() {
  cat <<EOF
generic:app-links <app>

Alias of generic:links. Lists services linked to an app.
EOF
}

cmd_promote_help() {
  cat <<EOF
generic:promote <service> <app>

When app has multiple linked services with the same alias prefix, promote
the given service to primary (PREFIX_*). The previous primary moves to PREFIX2_*.
EOF
}

cmd_expose_help() {
  cat <<EOF
generic:expose <service> <host_port>:<container_port>

Open service port on host via ambassador container. Does not restart service.
Idempotent — safe to call multiple times for the same spec.
EOF
}

cmd_unexpose_help() {
  cat <<EOF
generic:unexpose <service> <host_port>:<container_port>

Remove a port mapping for service. Tears down its per-port ambassador.
EOF
}

cmd_clone_help() {
  cat <<EOF
generic:clone <source> <new> [--copy-volumes] [override flags]

Copy a service to a new name. By default volumes are empty.
With --copy-volumes, named volume data is copied via busybox.
Linked apps are NOT cloned. Override flags accepted (same as create).
EOF
}

cmd_rename_help() {
  cat <<EOF
generic:rename <old> <new>

Rename a service. Moves state, copies volumes, updates docker-options
and config of all linked apps.
EOF
}
